@baseUrl = http://localhost:5080
@companyId = 1

### Create (ID is generated by the database)
POST {{baseUrl}}/api/main-companies
Content-Type: application/json

{
  "name": "Main Company",
  "uniqCode": "COMPANY-001",
  "address": "12 Main Street",
  "isActive": true
}

### Read a page
GET {{baseUrl}}/api/main-companies?page=1&pageSize=20

### Read by ID
GET {{baseUrl}}/api/main-companies/{{companyId}}

### Update
PUT {{baseUrl}}/api/main-companies/{{companyId}}
Content-Type: application/json

{
  "name": "Updated Main Company",
  "uniqCode": "COMPANY-001",
  "address": "34 Main Street",
  "isActive": false
}

### Delete
DELETE {{baseUrl}}/api/main-companies/{{companyId}}
